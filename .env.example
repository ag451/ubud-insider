# Ubud Insider — environment configuration
# Copy this file to ".env" for local development, or set these as service
# variables in the Railway dashboard for production.

# PostgreSQL connection string.
# - Local dev: leave UNSET to fall back to a local SQLite database.
# - Railway: provided automatically when you add the PostgreSQL plugin
#   (reference it as ${{Postgres.DATABASE_URL}}).
DATABASE_URL=

# Google Places API key. Required for the /api/places/* proxy endpoints
# (search, details, photo). Without it those endpoints return HTTP 500.
GOOGLE_PLACES_API_KEY=

# Set to "production" on Railway. Controls PostgreSQL SSL negotiation.
NODE_ENV=development

# Port the server listens on. Railway injects this automatically; defaults to 3000.
PORT=3000

# Base URL used only by one-off maintenance scripts (import-to-postgres.js,
# populate-why-this-place.js) when fetching data from a running API instance.
# API_BASE=http://localhost:3000/api
